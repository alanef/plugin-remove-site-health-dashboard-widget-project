{
  "phpVersion": "8.4",
  "plugins": [
    "./remove-site-heath-from-dashboard"
  ],
  "port": 8760,
  "testsPort": 8761,
  "config": {
    "WP_DEBUG_LOG": "/var/www/html/wp-content/debug.log",
    "WP_FS__DEV_MODE": true,
    "WP_DEBUG_DISPLAY": true
  },
  "mappings": {
    "tests": "./tests",
    "vendor": "./vendor",
    "phpunit.xml.dist": "./phpunit.xml.dist"
  },
  "env": {
    "development": {
      "mysqlPort": 62730
    },
    "tests": {
      "mysqlPort": 62731
    }
  }
}
